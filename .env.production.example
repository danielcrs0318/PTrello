# ================================
# ARCHIVO DE CONFIGURACIÓN PARA PRODUCCIÓN
# ================================
# 
# Este archivo es una PLANTILLA
# Copia este archivo como .env.production y modifica los valores
# 
# Comando: cp .env.production.example .env.production
#
# ⚠️ IMPORTANTE: NO SUBAS EL ARCHIVO .env.production CON DATOS REALES A GIT
#
# ================================

# ================================
# CONFIGURACIÓN DE BASE DE DATOS
# ================================

# Para producción, usa el host de tu servidor SQL Server en la nube
# Ejemplos:
# - Azure SQL: tu-servidor.database.windows.net
# - AWS RDS: tu-instancia.xxxxxxxxxx.us-east-1.rds.amazonaws.com
# - Servidor dedicado: ip.address o hostname
DB_HOST=tu-servidor-sql-produccion.com
DB_NAME=PTrello_Prod
DB_USER=prod_user
DB_PASSWORD=PASSWORD_SUPER_SEGURO_CAMBIAR
DB_PORT=1433
DB_ENCRYPT=true
# En producción, usa false solo si tienes certificados configurados correctamente
DB_TRUST_CERT=false

# ================================
# CONFIGURACIÓN DEL SERVIDOR
# ================================

PORT=3000
NODE_ENV=production

# URLs de tu dominio de producción (separadas por comas)
CORS_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# ================================
# AUTENTICACIÓN JWT
# ================================

# ⚠️ CRÍTICO: Genera una clave SEGURA para producción
# Comando recomendado: openssl rand -base64 64
JWT_SECRET=GENERAR_CLAVE_SUPER_SEGURA_MINIMO_64_CARACTERES

# ================================
# GOOGLE OAUTH
# ================================

# Credenciales de producción de Google Cloud Console
# Asegúrate de configurar las URLs de callback correctas
GOOGLE_CLIENT_ID=tu_google_client_id_produccion
GOOGLE_CLIENT_SECRET=tu_google_client_secret_produccion
GOOGLE_CALLBACK_URL=https://tu-dominio.com/auth/google/callback
GOOGLE_SUCCESS_REDIRECT=https://tu-dominio.com/auth/callback

# ================================
# CONFIGURACIÓN DE EMAIL
# ================================

# Servicio de envío de emails en producción
MAIL_SENDER_URL=https://api.tu-servicio-mail-produccion.com
MAIL_SENDER_API_KEY=tu_api_key_produccion_segura

# ================================
# FRONTEND (para docker-compose.prod.yml)
# ================================

# URL del backend para el frontend
VITE_API_URL=https://tu-dominio.com
