# ================================
# ARCHIVO DE CONFIGURACIÓN PRINCIPAL
# ================================
# 
# Este archivo es una PLANTILLA para el archivo .env del proyecto
# 
# Para desarrollo local:   cp .env.example backend/.env
# Para Docker local:       cp .env.local.example .env.local  
# Para Docker producción:  cp .env.production.example .env.production
#
# ================================

# ================================
# CONFIGURACIÓN DEL SERVIDOR
# ================================

PORT=3000
NODE_ENV=production

# ================================
# CONFIGURACIÓN DE BASE DE DATOS
# ================================

DB_NAME=SprintFlow
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# En producción real, usa el host de tu servidor SQL
# Ejemplos:
# - Desarrollo local: localhost\SQLEXPRESS
# - Azure SQL: tu-servidor.database.windows.net
# - AWS RDS: tu-instancia.region.rds.amazonaws.com
DB_HOST=YOUR_SQLSERVER_HOST

DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_CERT=false

# ================================
# AUTENTICACIÓN JWT
# ================================

# ⚠️ Genera una clave segura: openssl rand -base64 64
JWT_SECRET=CHANGE_ME

# ================================
# CORS
# ================================

# URLs permitidas (separadas por comas)
CORS_ORIGINS=https://your-frontend-domain

# ================================
# GOOGLE OAUTH
# ================================

GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_CALLBACK_URL=https://your-backend-domain/auth/google/callback
GOOGLE_SUCCESS_REDIRECT=https://your-frontend-domain/auth/callback

# ================================
# SERVICIO DE EMAIL (Opcional)
# ================================

MAIL_SENDER_URL=CHANGE_ME
MAIL_SENDER_API_KEY=CHANGE_ME
