# ================================
# CONFIGURACIÓN BACKEND - DESARROLLO LOCAL
# ================================
# 
# Copia este archivo como .env en la carpeta backend/
# Comando: cp .env.example .env
# 
# Este archivo es para ejecutar el backend SIN Docker
# Para Docker, usa los archivos .env.local o .env.production en la raíz
#
# ================================

# ================================
# CONFIGURACIÓN DEL SERVIDOR
# ================================

PORT=3000
NODE_ENV=development

# ================================
# CONFIGURACIÓN DE BASE DE DATOS
# ================================

# Tu SQL Server local de Windows
DB_HOST=localhost\SQLEXPRESS

# O si usas una instancia por defecto:
# DB_HOST=localhost

DB_NAME=PTrello
DB_USER=sa
DB_PASSWORD=tu_password_aqui
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_CERT=true

# ================================
# AUTENTICACIÓN JWT
# ================================

# Para desarrollo puedes usar cualquier string
# Para producción genera uno seguro: openssl rand -base64 64
JWT_SECRET=desarrollo_jwt_secret_key_cambiar

# ================================
# CORS
# ================================

# Puerto donde corre tu frontend (normalmente Vite usa 5173)
CORS_ORIGINS=http://localhost:5173

# ================================
# GOOGLE OAUTH (Opcional)
# ================================

# Credenciales de Google Cloud Console
# https://console.cloud.google.com/
GOOGLE_CLIENT_ID=tu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_SUCCESS_REDIRECT=http://localhost:5173/auth/callback

# ================================
# SERVICIO DE EMAIL (Opcional)
# ================================

# Si usas un servicio de envío de emails
MAIL_SENDER_URL=https://api.tu-servicio-mail.com
MAIL_SENDER_API_KEY=tu_api_key_aqui
