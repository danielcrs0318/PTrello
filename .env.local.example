# ================================
# ARCHIVO DE CONFIGURACIÓN PARA DOCKER LOCAL
# ================================
# 
# Este archivo es una PLANTILLA
# Copia este archivo como .env.local y modifica los valores
# 
# Comando: cp .env.local.example .env.local
#
# ================================

# ================================
# CONFIGURACIÓN DE BASE DE DATOS
# ================================

# Para desarrollo local sin Docker: localhost\SQLEXPRESS
# Para Docker con SQL Server en contenedor: nombre_del_servicio_db
DB_HOST=localhost\SQLEXPRESS
DB_NAME=PTrello
DB_USER=sa
DB_PASSWORD=tu_password_aqui
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_CERT=true

# ================================
# CONFIGURACIÓN DEL SERVIDOR
# ================================

PORT=3000
NODE_ENV=development

# Frontend URL para CORS (normalmente Vite usa puerto 5173)
CORS_ORIGINS=http://localhost:5173

# ================================
# AUTENTICACIÓN JWT
# ================================

# Puedes usar cualquier string para desarrollo
# Para generar uno seguro: openssl rand -base64 32
JWT_SECRET=desarrollo_jwt_secret_cambiar_en_produccion

# ================================
# GOOGLE OAUTH (Opcional)
# ================================

# Obtén estas credenciales en: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=tu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_SUCCESS_REDIRECT=http://localhost:5173/auth/callback

# ================================
# CONFIGURACIÓN DE EMAIL (Opcional)
# ================================

# Si usas un servicio de envío de emails
MAIL_SENDER_URL=https://api.tu-servicio-mail.com
MAIL_SENDER_API_KEY=tu_api_key_aqui
